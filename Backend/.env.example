PORT=5000
# JSON body limit (ariza: rasm/base64 katta bo‘lishi mumkin). Standart: 1gb
EXPRESS_JSON_LIMIT=1gb
MONGODB_URI=mongodb://127.0.0.1:27017/ishber
NODE_ENV=development
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
ADMIN_PHONE=+998900000000
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=superadmin123
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=1d

# Public form app — vacancy.applicationFormUrl va SMS havolalari
APPLICATION_FORM_BASE_URL=https://form.ishber.uz
# Path after base; must contain {vacancyId} (matches frontend route, e.g. React Router /vacancies/:id/apply)
APPLICATION_FORM_APPLY_PATH=vacancies/{vacancyId}/apply

# Suhbat eslatma SMS: 0 = scheduledAt vaqtiga yetgach; 60 = suhbatdan 60 daqiqa oldin
INTERVIEW_REMINDER_OFFSET_MINUTES=0
INTERVIEW_REMINDER_POLL_MS=60000
INTERVIEW_TIMEZONE=Asia/Tashkent

# Ariza yuborilganda nomzodga tasdiq SMS (Eskiz). Telefon body.phone yoki formadagi phone savolidan. O‘chirish: false
SUBMISSION_SMS_ON_SUBMIT=true
