# ishber.uz form — React SPA (Apache / LiteSpeed)
# Vite build: public/ → dist/ nusxalanadi

DirectoryIndex index.html

<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS (proxy orqali ham)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Mavjud fayl yoki papka — to‘g‘ridan-to‘g‘ri berish
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /vacancies/:id/apply va boshqa React Router yo‘llari
  RewriteRule ^ index.html [L]
</IfModule>

# SPA: 404 ham index.html (ba’zi hostinglarda qo‘shimcha)
ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>
  <FilesMatch "\.(js|css|mjs|woff2?|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript js mjs
  AddType text/css css
  AddType image/svg+xml svg svgz
</IfModule>

# Yashirin va maxfiy fayllar
<FilesMatch "(^\.|\.env|\.htaccess|\.htpasswd|\.git)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
